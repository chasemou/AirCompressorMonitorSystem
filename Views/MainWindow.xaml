<Window x:Class="WpfTest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTest.Views" 
        xmlns:sp="clr-namespace:WpfTest.Views.SubPages"
        Name="window"
        Foreground="#333"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="600" Width="1000">
    
    <!--取消自带边框与退出键等-->
    <WindowChrome.WindowChrome>
        <WindowChrome NonClientFrameEdges="None" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    <!--设置渐变色-->
    <Window.Background>
        <RadialGradientBrush>
            <GradientStop Color="WhiteSmoke" Offset="0"/>
            <GradientStop Color="LightBlue" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <!--设置style样式-->
    <Window.Resources>
        <sp:MonitorView x:Key="mv"/>
        <sp:AlarmView x:Key="av"/>
        <sp:TrendView x:Key="tv"/>
        <sp:SettingView x:Key="sv"/>
        <!--设置退出按钮样式-->
        <Style TargetType="Button" x:Key="CloseButtonStyle">
            <Setter Property="FontFamily" Value="{StaticResource Jinbuti}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#5979FD"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <!--设置button模板-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Margin="0,0,0,5"
                        BorderBrush="#5979FD" 
                        CornerRadius="10" 
                        BorderThickness="1" 
                        Background="Transparent"
                        x:Name="border">
                            <!--内容占位，content是什么模板中就显示什么-->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#335979FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5979FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--设置底部菜单栏样式-->
        <Style TargetType="RadioButton" x:Key="NavRadioButtonStyle">
            <Setter Property="FontFamily" Value="{StaticResource Jinbuti}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#888"/>
            <Setter Property="Width" Value="140"/>
            <!--设置底部菜单栏按钮模板-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="0.6" RadiusY="1">
                                            <GradientStop Color="#555797FD" Offset="0.2"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="0.6" RadiusY="1">
                                            <GradientStop Color="#555797FD" Offset="0.2"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#5797FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        
         <!--设置标题栏的下框-->
        <Path Data="M0 0 0 40 300 40 C310 50 310 50 320 50 L 650 50 C660 50 660 50 670 40 L1000 40 1000 0"
              Stretch="Fill"
              StrokeThickness="3">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"/>
            </Path.Fill>

            <!--下框渐变效果的实现-->
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="Pink" Offset="0.1"/>
                    <GradientStop Color="#5979FD" Offset="0.5"/>
                    <GradientStop Color="Pink" Offset="0.9"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>

        <!--设置左侧年月日以及星期,ConverterCulture意思为设置为中文-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5" FontSize="20">
            <Run Text="{Binding NowTime,StringFormat=yyyy-MM-dd}" FontFamily="{StaticResource Jinbuti}" />
            <Run Text="{Binding NowTime,StringFormat=dddd, ConverterCulture=zh}" FontFamily="{StaticResource Jinbuti}"/>
        </TextBlock>
        
        <!--顶部标题栏标题-->
        <TextBlock Text="空压机监控系统" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="30" FontFamily="{StaticResource Jinbuti}"/>
        <!--设置右侧实时时间和退出按钮-->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" >
            <TextBlock Text="{Binding NowTime,StringFormat=HH:mm:ss}" 
                       FontFamily="{StaticResource Jinbuti}"
                       FontSize="20" 
                       Margin="0,0,10,0"/>
            <Button Content="退出系统" 
                    Height="30" 
                    Width="100" 
                    Margin="10,0,10,0"
                    FontSize="15"
                    FontFamily="{StaticResource Jinbuti}"
                    Style="{StaticResource CloseButtonStyle}"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding ElementName=window}"/>
        </StackPanel>

         <!--底部菜单导航栏-->
        <Border Grid.Row="2"
                Width="750"
                CornerRadius="40"
                Background="#DFFF">
            <!--设置底部菜单栏阴影效果-->
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  Color="Gray"
                                  ShadowDepth="0"
                                  Opacity="0.2">
                </DropShadowEffect>
            </Border.Effect>

            <UniformGrid Rows="1" HorizontalAlignment="Center">
                <RadioButton Content="&#xe6d0; 监控" Style="{StaticResource NavRadioButtonStyle}"
                             FontFamily="{StaticResource Iconfont}"
                             IsChecked="True"
                             Command="{Binding NavCommand}"
                             CommandParameter="{StaticResource mv}"/>
                <RadioButton Content="&#xe608; 趋势" Style="{StaticResource NavRadioButtonStyle}"
                             FontFamily="{StaticResource Iconfont}"
                             Command="{Binding NavCommand}"
                             CommandParameter="{StaticResource tv}"/>
                <RadioButton Content="&#xe871; 报警" Style="{StaticResource NavRadioButtonStyle}"
                             FontFamily="{StaticResource Iconfont}"
                             Command="{Binding NavCommand}"
                             CommandParameter="{StaticResource av}"/>
                <RadioButton Content="&#xe70f; 设置" Style="{StaticResource NavRadioButtonStyle}"
                             FontFamily="{StaticResource Iconfont}"
                             Command="{Binding NavCommand}"
                             CommandParameter="{StaticResource sv}"/>
            </UniformGrid>
        </Border>

        <!--页面切换-->
        <ContentControl Grid.Row="1" Content="{Binding PageContent, TargetNullValue={StaticResource mv} }"/>
    </Grid>
</Window>
