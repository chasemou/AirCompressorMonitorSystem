<UserControl x:Class="WpfTest.Views.SubPages.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfTest.Views.SubPages"
             xmlns:viewmodels="clr-namespace:WpfTest.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--分组框样式-->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <ContentPresenter ContentSource="Header"
                                              TextBlock.FontFamily="{StaticResource Jinbuti}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="10,0"
                                              TextBlock.FontSize="18"
                                              TextBlock.Foreground="#5979FD"/>
                            <ContentPresenter Grid.Row="1" Margin="10,0,10,10"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--输入框统一样式-->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!--标签统一样式-->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Jinbuti}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!--按钮样式-->
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Jinbuti}"/>
            <Setter Property="Background" Value="#5979FD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A5FE0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="系统设置" FontFamily="{StaticResource Jinbuti}" FontSize="28"
                   HorizontalAlignment="Center" Foreground="#5979FD" Margin="0,5,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--================ 左列 ================-->
                <StackPanel Grid.Column="0" Margin="0,0,5,0">

                    <!--设备设置-->
                    <GroupBox Header="设备设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="总设备数量" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding SettingVM.TotalDeviceCount}"/>

                            <TextBlock Grid.Row="1" Text="本设备编号" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SettingVM.DeviceId}"/>
                        </Grid>
                    </GroupBox>

                    <!--报警阈值设置（修改后实时生效）-->
                    <GroupBox Header="报警阈值设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="压力高限" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding SettingVM.PressureHighLimit}"/>
                            <TextBlock Grid.Column="2" Text="MPa" Style="{StaticResource LabelStyle}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="1" Text="温度高限" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SettingVM.TemperatureHighLimit}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="℃" Style="{StaticResource LabelStyle}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="2" Text="湿度高限" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SettingVM.HumidityHighLimit}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="%" Style="{StaticResource LabelStyle}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="3" Text="流量高限" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SettingVM.FlowHighLimit}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="m³/min" Style="{StaticResource LabelStyle}" Margin="8,0,0,0"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>

                <!--================ 右列 ================-->
                <StackPanel Grid.Column="1" Margin="5,0,0,0">

                    <!--通信设置（修改后需点"应用并重新连接"）-->
                    <GroupBox Header="通信设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="串口号" Style="{StaticResource LabelStyle}"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding SettingVM.AvailablePorts}"
                                          Text="{Binding SettingVM.PortName}"
                                          IsEditable="True"/>
                                <Button Grid.Column="1" Content="刷新"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Margin="5,3,0,3"
                                        Padding="8,0"
                                        Command="{Binding SettingVM.RefreshPortsCommand}"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="波特率" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding SettingVM.BaudRates}"
                                      SelectedValue="{Binding SettingVM.BaudRate}"/>

                            <TextBlock Grid.Row="2" Text="从站地址" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SettingVM.SlaveAddress}"/>

                            <TextBlock Grid.Row="3" Text="连接状态" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,3">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="● 未连接"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="● 已连接"/>
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Row="4" Grid.Column="1" Content="应用并重新连接"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding SettingVM.ApplyCommSettingsCommand}"/>
                        </Grid>
                    </GroupBox>

                    <!--数据采集设置-->
                    <GroupBox Header="数据采集设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="轮询间隔" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding SettingVM.PollIntervalSeconds}"/>
                            <TextBlock Grid.Column="2" Text="秒" Style="{StaticResource LabelStyle}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="1" Text="趋势保留点数" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SettingVM.MaxTrendPoints}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="点" Style="{StaticResource LabelStyle}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="2" Text="压力缩放" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SettingVM.PressureScale}"/>

                            <TextBlock Grid.Row="3" Text="温度缩放" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SettingVM.TemperatureScale}"/>

                            <TextBlock Grid.Row="4" Text="湿度缩放" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SettingVM.HumidityScale}"/>

                            <TextBlock Grid.Row="5" Text="流量缩放" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SettingVM.FlowScale}"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
