<UserControl x:Class="WpfTest.Views.SubPages.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfTest.Views.SubPages"
             xmlns:view="clr-namespace:WpfTest.Views"
             xmlns:viewmodels="clr-namespace:WpfTest.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <ContentPresenter ContentSource="Header"
                                              TextBlock.FontFamily="{StaticResource Jinbuti}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="15,0"
                                              TextBlock.FontSize="20"
                                              TextBlock.Foreground="#5979FD"/>
                            <ContentPresenter Grid.Row="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--实时状态-->
        <GroupBox>
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="实时状态" Margin="0,0,15,0"/>
                    <!--Modbus 连接状态指示-->
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="● 未连接"/>
                                <Setter Property="Foreground" Value="#C62828"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="● 已连接"/>
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </GroupBox.Header>
            <Grid TextBlock.FontFamily="{StaticResource Jinbuti}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!--实时数值卡片（绑定 Modbus 实时数据，顺序：压力→温度→湿度→流量）-->
                <UniformGrid Rows="1" Margin="10">
                    <Border Background="#9FFF" CornerRadius="10" Margin="3">
                        <StackPanel Margin="3">
                            <TextBlock Text="{Binding MonitorVM.CurrentPressure, StringFormat={}{0:F2}MPa}" Foreground="orange"
                                    HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                    Margin="5"/>
                            <TextBlock Text="压力" Foreground ="#A000"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#9FFF" CornerRadius="10" Margin="3">
                    <StackPanel Margin="3">
                        <TextBlock Text="{Binding MonitorVM.CurrentTemperature, StringFormat={}{0:F1}℃}" Foreground="IndianRed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="5"/>
                        <TextBlock Text="温度" Foreground ="#A000"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    </Border>

                    <Border Background="#9FFF" CornerRadius="10" Margin="3">
                    <StackPanel Margin="3">
                        <TextBlock Text="{Binding MonitorVM.CurrentHumidity, StringFormat={}{0:F1}%}" Foreground="OrangeRed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="5"/>
                        <TextBlock Text="湿度" Foreground ="#A000"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    </Border>

                    <Border Background="#9FFF" CornerRadius="10" Margin="3">
                        <StackPanel Margin="3">
                            <TextBlock Text="{Binding MonitorVM.CurrentFlow, StringFormat={}{0:F1}}" Foreground="Green"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="5,5,5,0"/>
                            <TextBlock Text="m³/min" Foreground="#A000" FontSize="11"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,3"/>
                            <TextBlock Text="流量" Foreground ="#A000"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Rows="2" Grid.Row="1">
                    <Border Background="#9FFF" CornerRadius="10" Margin="5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="总设备量" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SettingVM.TotalDeviceCount}" FontSize="15" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#9FFF" CornerRadius="10" Margin="5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="正在报警" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AlarmCount}" FontSize="15" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#9FFF" CornerRadius="10" Margin="5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="运行时长" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MonitorVM.RunningDuration}" FontSize="15" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#9FFF" CornerRadius="10" Margin="5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="已停机" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MonitorVM.StoppedCount}" FontSize="15" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#9FFF" CornerRadius="10" Margin="5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="运转率" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MonitorVM.OperatingRate, StringFormat={}{0}%}" FontSize="15" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#9FFF" CornerRadius="10" Margin="5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="在线设备" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MonitorVM.OnlineCount}" FontSize="15" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!--系统日志（Row 2 空白区域）-->
                <Border Grid.Row="2" Margin="5" Background="#9FFF" CornerRadius="10">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="系统日志" FontSize="14" Foreground="#5979FD" Margin="2,0,0,3"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Logger.Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" Foreground="#888" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text=" " FontSize="11"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Level}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Text=" " FontSize="11"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Message}" Foreground="#333"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       ToolTip="{Binding Message}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <!--实时趋势：与趋势页上方两张图共用同一数据源（实时气体压力/实时气体温度）-->
        <GroupBox Header="实时趋势" Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <view:TrendChartControl Grid.Row="0"
                                        ChartTitle="实时气体压力"
                                        ChartSeries="{Binding PressureValue}"
                                        ChartStroke="#2E7D32"
                                        MaxValue="1.6"/>

                <view:TrendChartControl Grid.Row="1"
                                        ChartTitle="实时气体温度"
                                        ChartSeries="{Binding TemperatureValue}"
                                        ChartStroke="#FF7043"
                                        MaxValue="150"/>
            </Grid>
        </GroupBox>

        <!--异常报警-->
        <GroupBox Header="异常报警" Grid.Column="2">
            <ItemsControl Margin="5,0" ItemsSource="{Binding AlarmList}" FontFamily="{StaticResource Jinbuti}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Index}"
                                       Foreground="#9000"/>
                            <TextBlock Text="{Binding MsgTime, StringFormat=MM/dd HH:mm}" 
                                       Grid.Column="1" 
                                       Foreground="#9000"/>
                            <TextBlock Text="{Binding Message}" 
                                       Grid.Column="2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding MesType}" 
                                       Grid.Column="3" 
                                       Foreground="Red"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>
    </Grid>
</UserControl>
