<UserControl x:Class="WpfTest.Views.SubPages.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfTest.Views.SubPages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="异常报警界面" FontFamily="{StaticResource Jinbuti}"
                   FontSize="30"
                   HorizontalAlignment="Center"
                   Foreground="Red"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,10,5,5">
            <TextBlock Text="报警信息" FontFamily="{StaticResource Jinbuti}"
                       FontSize="20"/>
            <!--当前报警（未修复）设备数量，触发报警 +1、恢复报警 -1-->
            <TextBlock FontFamily="{StaticResource Jinbuti}"
                       FontSize="20"
                       Margin="20,0,0,0"
                       Text="{Binding AlarmCount, StringFormat=当前报警设备数量：{0} 台}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="Red"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AlarmCount}" Value="0">
                                <Setter Property="Foreground" Value="#2E7D32"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!--表头：序号/设备编号/报警项/报警提示/报警时间/修复时间/级别-->
        <Border Grid.Row="2" Margin="10,5,10,5" Background="#E3F2FD" CornerRadius="4" Padding="8,6"
                TextBlock.FontFamily="{StaticResource Jinbuti}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="序号" FontWeight="Bold"/>
                <TextBlock Text="设备编号" Grid.Column="1" FontWeight="Bold"/>
                <TextBlock Text="报警项" Grid.Column="2" FontWeight="Bold"/>
                <TextBlock Text="报警提示" Grid.Column="3" FontWeight="Bold"/>
                <TextBlock Text="报警时间" Grid.Column="4" FontWeight="Bold"/>
                <TextBlock Text="修复时间" Grid.Column="5" FontWeight="Bold"/>
                <TextBlock Text="级别" Grid.Column="6" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!--报警列表：未修复(处理中)红底提醒，已修复显示修复实时时间-->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,5,10,5">
            <ItemsControl ItemsSource="{Binding AlarmList}" FontFamily="{StaticResource Jinbuti}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="32" Margin="10,1">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="#14A5D6A7"/>
                                    <Style.Triggers>
                                        <!--未修复报警：浅红底醒目显示-->
                                        <DataTrigger Binding="{Binding RemoveTime}" Value="{x:Null}">
                                            <Setter Property="Background" Value="#20FF5252"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Index}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DeviceId}" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ItemName}" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Message}" Grid.Column="3" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding MsgTime, StringFormat=MM/dd HH:mm:ss}" Grid.Column="4"
                                       VerticalAlignment="Center" Foreground="#9000"/>

                            <!--修复时间：处理中为红色，已修复为绿色实时时间-->
                            <TextBlock Text="{Binding RemoveTime, StringFormat=MM/dd HH:mm:ss, TargetNullValue=处理中}"
                                       Grid.Column="5" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RemoveTime}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding MesType}" Grid.Column="6" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Orange"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MesType}" Value="紧急">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
