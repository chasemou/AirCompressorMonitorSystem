<UserControl x:Class="WpfTest.Views.TrendChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="400">
    <!--趋势图的外层边框-->
    <Border Background="#F5FAF7" CornerRadius="10" Margin="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--趋势图标题，绑定ChartTitle依赖属性-->
            <TextBlock Text="{Binding ChartTitle, ElementName=Root}"
                   Grid.Row="0"
                   FontFamily="{StaticResource Jinbuti}"
                   FontSize="14"
                   Margin="10,8,10,6"/>

            <!--趋势图部分：数据源由代码后台挂载（确保 LiveCharts 正确订阅集合变化）-->
            <lvc:CartesianChart x:Name="chart" Grid.Row="1" Margin="5,0,5,10">
                <lvc:CartesianChart.Series>
                    <lvc:LineSeries x:Name="line"
                                    Stroke="{Binding ChartStroke, ElementName=Root}"
                                    StrokeThickness="2"
                                    PointGeometrySize="0"
                                    LineSmoothness="0.5"
                                    Fill="{x:Null}"/>
                </lvc:CartesianChart.Series>

                <lvc:CartesianChart.AxisX>
                    <!--X轴时间标签：由代码后台设置 LabelFormatter，按索引换算为当前时间-->
                    <lvc:Axis x:Name="xAxis"
                              ShowLabels="True"
                              Foreground="#888"
                              FontSize="10">
                        <lvc:Axis.Separator>
                            <lvc:Separator Stroke="#2090C8E0" StrokeThickness="1"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>

                <lvc:CartesianChart.AxisY>
                    <!--Y轴量程由代码后台按 MinValue/MaxValue 依赖属性赋值，保证生效-->
                    <lvc:Axis x:Name="yAxis"
                              Foreground="#888"
                              FontSize="10">
                        <lvc:Axis.Separator>
                            <lvc:Separator Stroke="#2090C8E0" StrokeThickness="1"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>
    </Border>
</UserControl>
